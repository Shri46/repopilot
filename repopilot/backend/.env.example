# Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://repopilot:repopilot@localhost:5433/repopilot

# Optional. Only needed when DATABASE_URL points at a connection pooler (e.g. Neon's
# -pooler host, which is PgBouncer in transaction mode and can't run session-level
# statements like CREATE EXTENSION). init_db.py uses this for schema work and falls back
# to DATABASE_URL when it's empty, so local Docker setups can leave it unset.
DATABASE_URL_UNPOOLED=

# Agent behavior
AGENT_MAX_STEPS=6
AGENT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Retrieval
RETRIEVAL_TOP_K=8

# The ingest UI's folder picker browses the *server's* filesystem. Fine for local use;
# set this to false on any deployment reachable by anyone else, and ingest via the
# clone-from-URL flow instead.
ENABLE_FS_BROWSER=true

# --- Public-deployment guardrails ---
# All off by default (0 / false = unlimited). Turn them on for a public demo, where the
# real risk is one visitor ingesting a huge repo and burning the day's Gemini quota.
# Suggested public values are in the comments.
MAX_INGEST_CHUNKS=0            # e.g. 400 — reject big repos before spending embeddings
MAX_PROJECTS=0                 # e.g. 10  — cap total projects
RATE_LIMIT_ENABLED=false       # e.g. true
RATE_LIMIT_INGEST_PER_HOUR=3
RATE_LIMIT_QUERY_PER_HOUR=30
RATE_LIMIT_EVAL_PER_HOUR=2
